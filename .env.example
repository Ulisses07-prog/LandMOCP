# Configurações Gerais
APP_NAME="Arruda Móveis Eletro - Catálogo"
APP_ENV=development
SECRET_KEY=change-this-in-production-use-a-strong-random-secret-key-32chars
API_V1_STR=/api/v1

# Banco de Dados (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=arruda_catalogo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arruda_catalogo

# Armazenamento de Mídia (local ou cloud)
MEDIA_STORAGE=local
MEDIA_LOCAL_PATH=./media/uploads

# Provedor Cloud (caso MEDIA_STORAGE=cloud)
CLOUD_PROVIDER=s3
CLOUD_BUCKET=arruda-catalogo-media
CLOUD_ACCESS_KEY=
CLOUD_SECRET_KEY=
CLOUD_REGION=us-east-1

# Atendimento Comercial / WhatsApp
WHATSAPP_NUMBER=5581999999999

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WHATSAPP_NUMBER=5581999999999
